        }
      ],
      "destination": "/api/tienda-og?slug=:slug"
    },
    {
      "source": "/p/:slug",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?global3d\\.com\\.ar"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|Instagram|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|Pinterest|SkypeUriPreview|redditbot|Applebot).*"
        }
      ],
