# Supabase project URL — required (copy to .env and fill in)
VITE_SUPABASE_URL=

# Supabase anon public key — required (public by design; RLS is the security boundary)
VITE_SUPABASE_ANON_KEY=

# Integration tests (`npm run test:integration`) read .env.integration instead:
# same three keys (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY) but for a separate, disposable Supabase project.
# They refuse to run against the workshop's real project.
