# Supabase project URL — required (copy to .env and fill in)
VITE_SUPABASE_URL=

# Supabase anon public key — required (public by design; RLS is the security boundary)
VITE_SUPABASE_ANON_KEY=

# Dev-only: set to 1 to enable the seeded operator session seam (no login UI).
# No credentials live here — the operator password is generated at runtime.
VITE_ENABLE_DEV_SESSION=
